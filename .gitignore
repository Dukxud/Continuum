# Generated app/session state (never commit job configuration or logs)
*.log
*.jsonl
CodexResume-*.json
BP*-Codex-*.ps1
node_modules/
.DS_Store

# Generated acceptance artifacts and pinned Microsoft SDK binaries
AeroWebView2/
AeroScreenshots/
QA-results-local-*/

