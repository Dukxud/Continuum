/src/desktop/.dart_tool/
/src/desktop/build/
/src/desktop/windows/
/src/desktop/.flutter-plugins
/src/desktop/.flutter-plugins-dependencies
/src/desktop/.metadata
/src/desktop/.gitignore
/src/desktop/.idea/
/src/desktop/*.iml
/src/desktop/test/captures/

# Local preview packages
/PreviewArtifacts/
/ComponentArtifacts/
/ReusableArtifacts/
